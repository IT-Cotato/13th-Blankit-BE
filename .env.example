# Database
DB_NAME=blankit
DB_USERNAME=blankit_user
# MySQL root 비밀번호
DB_PASSWORD=your_root_password_here
# MySQL 일반 유저 비밀번호
DB_USER_PASSWORD=your_user_password_here
# prod: mysql 컨테이너 서비스명을 호스트로 사용 / local: 127.0.0.1:3307
DB_URL=jdbc:mysql://127.0.0.1:3307/blankit?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia%2FSeoul
# 현재 개발 서버 CD는 누락된 스키마를 자동 반영하기 위해 update를 사용합니다.
JPA_DDL_AUTO=update

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
APP_TIME_ZONE=Asia/Seoul

# FCM (운영 CD에서는 FIREBASE_ENABLED=true를 명시적으로 전달합니다.)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
PUSH_SCHEDULER_FIXED_DELAY=60000
PUSH_PROCESSING_LEASE_MILLIS=300000
PUSH_MAX_JOBS_PER_TICK=100
# ISO-8601 Duration 목록: 1분, 5분, 15분, 1시간
PUSH_RETRY_DELAYS=PT1M,PT5M,PT15M,PT1H
THIRTY_MIN_PACK_HORIZON_DAYS=14
THIRTY_MIN_PACK_REFRESH_CRON='0 10 0 * * *'
TASK_DEADLINE_TIME=09:00
TASK_DEADLINE_REFRESH_CRON='0 20 0 * * *'
REPEAT_DEADLINE_CRON='0 5 0 * * *'
PUSH_TASK_DETAIL_PATH=/tasks/{taskId}
PUSH_THIRTY_MIN_PACK_PATH='/recommendations/pack30?availableMinutes={minutes}'
